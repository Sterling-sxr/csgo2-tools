{
  "name": "csgo2-tools",
  "version": "0.1.0",
  "description": "FACEIT live match companion for Counter-Strike 2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "cloud:typecheck": "tsc -p cloud-api/tsconfig.json",
    "cloud:dev": "wrangler dev --config cloud-api/wrangler.jsonc",
    "cloud:secret": "wrangler secret put FACEIT_API_KEY --config cloud-api/wrangler.jsonc",
    "cloud:deploy": "wrangler deploy --config cloud-api/wrangler.jsonc"
  },
  "keywords": [
    "cs2",
    "faceit",
    "nextjs"
  ],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "^7.0.2",
    "wrangler": "4.156.0"
  }
}
